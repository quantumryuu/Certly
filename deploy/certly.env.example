# /etc/certly/certly.env (chmod 600). Read by certly.service and certly-backup.service.
# Optional. If set, every certificate embeds <url>/crl/<id>.crl as its CRL address.
# Leave unset if your servers load the CRL from a file (nginx ssl_crl, HAProxy crl-file).
# CERTLY_BASE_URL=https://certly.lan
# If a TLS reverse proxy is in front of Certly:
# CERTLY_SECURE_COOKIES=true
CERTLY_LISTEN=127.0.0.1:8080
# Serve HTTPS directly (or leave empty and use a reverse proxy):
# CERTLY_TLS_CERT=/var/lib/certly/tls/fullchain.pem
# CERTLY_TLS_KEY=/var/lib/certly/tls/key.pem
# If a reverse proxy runs on this host:
# CERTLY_TRUSTED_PROXIES=127.0.0.1/32
# If forms fail with "Request blocked / Origin does not match Host", trust the URL you browse with:
# CERTLY_ALLOWED_ORIGINS=http://192.168.1.10:8080
# CERTLY_LOG_FORMAT=json
